    { "key": "lineHeight", "label": { "ko": "스캔라인 간격(픽셀)", "en": "Line spacing (px)", "ja": "走査線の間隔(px)", "zh": "扫描线间距(px)" }, "default": 3.0, "min": 2.0, "max": 8.0 },
    { "key": "mask", "label": { "ko": "RGB 마스크", "en": "RGB mask", "ja": "RGBマスク", "zh": "RGB遮罩" }, "default": 0.2, "min": 0.0, "max": 1.0 },
    { "key": "curvature", "label": { "ko": "화면 휨", "en": "Curvature", "ja": "湾曲", "zh": "弯曲度" }, "default": 0.15, "min": 0.0, "max": 0.5 }
  ]
}
